---
import '@fontsource/black-han-sans/400.css';
import '@fontsource/hahmlet/400.css';
import '@fontsource/hahmlet/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/base.css';
import '../styles/tokens.css';
import '../styles/wall.css';
import '../styles/detail.css';
import '../styles/outro.css';
import plateJson from '../generated/plate.json';
import type { PageView } from '../lib/view.ts';
import { DEFAULT_LOCALE, LOCALE_KEY } from '../i18n/index.ts';

interface Props { view: PageView }
const { view } = Astro.props;
// 아이콘도 base 아래에 둔다. '/favicon.png'로 쓰면 메인 사이트 아이콘이 대신 뜬다 (scripts/favicon.ts로 생성)
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/* 판 글꼴: 이 언어의 판에 새길 글자만 담은 조각(scripts/plate-font.ts). 글자가 대체 서체로 새겨지지 않도록 block */
const plates = (plateJson as Record<string, { family: string; file: string }[]>)[view.lang] ?? [];
const plateCss = plates.map(p => `@font-face{font-family:${p.family};src:url(${base}${p.file}) format("woff2");font-display:block}`).join('')
  + `:root{--plate:${[...plates.map(p => p.family), 'var(--display)'].join(', ')}}`;
/* 고른 언어 기억(LOCALE_KEY, 사이트 전체가 함께 쓴다).
   - 언어 링크를 누르면 그 언어를 적는다. 모듈 스크립트보다 먼저 돌도록 머리의 인라인 스크립트로 둔다
   - 기본 언어 주소(base)로 들어왔을 때만, 다른 언어를 고른 적이 있으면 그 주소로 옮긴다. 그리기 전에 옮겨서 다른 언어가 비치지 않는다.
     ko/처럼 언어 주소를 직접 열면 그 주소를 따른다(받은 링크는 받은 대로 보인다) */
const k = JSON.stringify(LOCALE_KEY);
const remember = `document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('nav.lang a[hreflang]');if(a)try{localStorage.setItem(${k},a.hreflang)}catch(x){}},true)`;
const away = Object.fromEntries(view.langs.filter(l => !l.current && l.path !== null).map(l => [l.code, base + l.path]));
const follow = view.lang === DEFAULT_LOCALE
  ? `try{var m=${JSON.stringify(away)},v=localStorage.getItem(${k});if(v&&Object.prototype.hasOwnProperty.call(m,v))location.replace(m[v]+location.search+location.hash)}catch(x){}`
  : '';
---
<!doctype html>
<html lang={view.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{follow && <script is:inline set:html={follow}></script>}
<script is:inline set:html={remember}></script>
<script is:inline>document.documentElement.classList.add('js')</script>
<title>{view.title}</title>
<meta name="description" content={view.description}>
<link rel="canonical" href={view.canonical}>
{view.alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
<link rel="alternate" type="application/json" title={view.name} href={view.feeds.json}>
<link rel="alternate" type="application/rss+xml" title={view.name} href={view.feeds.rss}>
<meta property="og:type" content="website">
<meta property="og:url" content={view.canonical}>
<meta property="og:title" content={view.ogTitle}>
<meta property="og:description" content={view.ogDescription}>
<meta property="og:image" content={view.ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{plates.map(p => <link rel="preload" as="font" type="font/woff2" href={base + p.file} crossorigin>)}
<style is:inline set:html={plateCss}></style>
<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`}>
<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`}>
<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`}>
{/* 모듈 스크립트는 문서를 다 읽은 뒤에 돈다. 머리에 두는 것은 일찍 받기 위해서다(긴 본문 끝에 두면 본문 글꼴과 대역을 다투다 늦게 온다) */}
<script>import '../client/main.ts';</script>
</head>
<body>
<slot />
</body>
</html>
