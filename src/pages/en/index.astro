---
import Page from '../../layouts/Page.astro';
import TopBar from '../../components/TopBar.astro';
import Wall from '../../components/Wall.astro';
import Details from '../../components/Details.astro';
import DetailDialog from '../../components/DetailDialog.astro';
import Outro from '../../components/Outro.astro';
import { loadContent } from '../../lib/content.ts';
import { buildView } from '../../lib/view.ts';

// 영어 사이트 글(site.en)이 생기기 전에는 한국어 페이지로 보낸다
const c = loadContent();
if (!c.site.en) return Astro.redirect(import.meta.env.BASE_URL.replace(/\/?$/, '/'));
const view = buildView(c, 'en');
---
<Page view={view}>
<TopBar view={view} />
<Wall view={view} />
<Details view={view} />
<Outro view={view} />
<DetailDialog view={view} />
</Page>
