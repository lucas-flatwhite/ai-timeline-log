---
import type { PageView } from '../lib/view.ts';
const { view } = Astro.props as { view: PageView };
const p = view.ui.pick;
/* 강조 띠: 지금 무엇을 골랐는지(시기, 주제, 찾기, 새 상자)와 상자 수를 위 막대 아래에 보인다. 시기는 글과 앞뒤 시기 단추까지.
   문구 틀은 data-*에 두고 스크립트(client/pickbar.ts)가 채운다 */
---
<div class="pickbar" id="pickbar" hidden
  data-era={p.era} data-topic={p.topic} data-find={p.find} data-new={p.new} data-boxes={p.boxes} data-box1={p.box1} data-none={p.none}>
  <div class="pb-row">
    <button class="pb-prev" type="button" aria-label={view.ui.eraPrev}>‹</button>
    <p class="pb-t" aria-live="polite"><b class="pb-k"></b><span class="pb-name"></span><span class="pb-n"></span></p>
    <button class="pb-next" type="button" aria-label={view.ui.eraNext}>›</button>
    <button class="pb-x" type="button" aria-label={p.clear}>×</button>
  </div>
  <p class="pb-body"></p>
</div>
<script type="application/json" id="eras" is:inline set:html={JSON.stringify(view.eras).replace(/</g, '\\u003c')}></script>
