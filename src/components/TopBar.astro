---
import type { PageView } from '../lib/view.ts';
import LangSwitch from './LangSwitch.astro';
const { view } = Astro.props as { view: PageView };
const u = view.ui;
---
<header class="top">
  <b class="name">{view.name}</b>
  {/* 찾기: 검색, 시기, 주제를 한 창에 둔다. 고르면 그 상자만 남기고 흐리게 한다. 스크립트가 있을 때만 보인다(html.js) */}
  <div class="tp">
    <button class="tp-btn" type="button" aria-expanded="false" aria-controls="tp-list">{u.find}</button>
    <div id="tp-list" class="tp-list" hidden>
      <p class="tp-q">
        <input type="search" enterkeyhint="search" autocomplete="off" spellcheck="false" placeholder={u.findPlaceholder} aria-label={u.findLabel} aria-describedby="tp-n">
        <span id="tp-n" class="tp-n" aria-live="polite"></span>
      </p>
      <h3 class="tp-h">{u.eras}</h3>
      <ul>{view.eras.map((e, i) => <li><button type="button" data-era={e.from}><span class="tp-i">{i + 1}</span><span class="tp-t">{e.title}</span><span class="tp-s">{e.span}</span></button></li>)}</ul>
      <h3 class="tp-h">{u.topic}</h3>
      <ul>
        <li><button type="button" data-topic="">{u.topicAll}</button></li>
        {view.topics.map(t => <li><button type="button" data-topic={t.id} data-name={t.name}><span class="tp-t">{t.name}</span><span class="tp-s">{t.count}</span></button></li>)}
      </ul>
    </div>
  </div>
  <LangSwitch view={view} />
  <a class="report" href={view.report.href} target="_blank" rel="noopener" data-report aria-haspopup="dialog">{view.report.label}</a>
</header>
