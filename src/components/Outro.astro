---
import type { PageView } from '../lib/view.ts';
import LangSwitch from './LangSwitch.astro';
const { view } = Astro.props as { view: PageView };
const o = view.outro;
const p = o.take.poster;
/* 교정지: 520 너비 좌표에 포스터(가로 300)를 놓고 둘레에 재단선·치수선·맞춤표를 긋는다. 미리보기 그림은 늦게 읽는 img로 그 자리에 얹는다 */
const pf = p?.proof && (() => {
  const W = 520, X = 110, PW = 300, Y = 72, PH = PW * p.proof.h / p.proof.w, B = Y + PH, MY = Y + PH / 2, H = B + 110;
  const crop = [[X, Y, -1, -1], [X + PW, Y, 1, -1], [X, B, -1, 1], [X + PW, B, 1, 1]]
    .map(([x, y, sx, sy]) => `M${x + sx * 8} ${y}h${sx * 16}M${x} ${y + sy * 8}v${sy * 16}`).join('');
  const reg = (x: number, y: number) => `M${x - 12} ${y}h24M${x} ${y - 12}v24`;
  return {
    W, H, X, PW, Y, PH, B, MY, crop, reg: reg(60, MY) + reg(W / 2, B + 52),
    img: `left:${(X / W) * 100}%;top:${(Y / H) * 100}%;width:${(PW / W) * 100}%`,
  };
})();
const r1 = (n: number) => Math.round(n * 10) / 10;
---
<section class="outro" id="outro" aria-labelledby="outroH">
  <div class="outro-in">
    <p class="eyebrow">{o.eyebrow}</p>
    <h2 id="outroH" data-live={o.titleTpl}>{o.title}</h2>
    {/* 시기마다 벽에서 그 기간의 상자만 남기는 링크. 스크립트가 없으면 주소만 바뀐다 */}
    <ol class="arcs">{o.arcs.map(a => <li><span class="span">{a.span}</span><h3>{a.title}</h3><p>{a.body} <a class="arc-go" href={`?era=${a.from.slice(0, 4)}-${a.from.slice(4)}`} data-era={a.from}>{view.ui.eraShow} ↑</a></p></li>)}</ol>

    <h2 class="sub">{o.ledgerTitle}</h2>
    <p class="note">{o.ledgerNote}</p>
    <div class="ledger" id="ledger">{o.ledger.map(l => <div class="lab"><h3>{l.lab}</h3><ol>{l.models.map(m => <li>{m.name}<time>{m.date}</time></li>)}</ol></div>)}</div>

    {/* 가져가기: 포스터(파일은 GitHub Releases, 미리보기만 사이트), 피드, AI에게 건네기 */}
    <section class="take" id="take" aria-labelledby="takeH">
      <h2 class="sub" id="takeH">{o.take.title}</h2>
      {p && <div class:list={['pst', { bare: !pf }]} id="take-poster">
        {p.proof && pf && <figure class="proof" style={`aspect-ratio:${pf.W}/${r1(pf.H)}`}>
          <img src={p.proof.src} width={p.proof.w} height={p.proof.h} alt={p.proof.alt} loading="lazy" decoding="async" style={pf.img}>
          <svg viewBox={`0 0 ${pf.W} ${r1(pf.H)}`} aria-hidden="true">
            <path class="ln" d={pf.crop + pf.reg} />
            <circle class="ln" cx="60" cy={r1(pf.MY)} r="8" /><circle class="ln" cx={pf.W / 2} cy={r1(pf.B + 52)} r="8" />
            <path class="ln" d={`M${pf.X} 34v12M${pf.X + pf.PW} 34v12M${pf.X} 40h${pf.PW / 2 - 36}M${pf.X + pf.PW / 2 + 36} 40h${pf.PW / 2 - 36}`} />
            <path class="ln" d={`M440 ${pf.Y}h12M440 ${r1(pf.B)}h12M446 ${pf.Y}V${r1(pf.MY - 36)}M446 ${r1(pf.MY + 36)}V${r1(pf.B)}`} />
            <text x={pf.X + pf.PW / 2} y="44.5" text-anchor="middle">{p.proof.width}</text>
            <text transform={`translate(446 ${r1(pf.MY)}) rotate(90)`} y="4.5" text-anchor="middle">{p.proof.height}</text>
            {['paper', 'wood', 'ghost', 'ink-2', 'ink'].map((k, i) => <rect class={`st ${k}`} x={pf.X + i * 16} y={r1(pf.B + 76)} width="16" height="16" />)}
            <text class="cap" x={pf.X + 92} y={r1(pf.B + 88)}>{p.proof.caption}</text>
          </svg>
        </figure>}
        <div class="pi">
          <p class="eyebrow">{p.label}</p>
          <h3>{p.note}</h3>
          <p class="d">{p.desc}</p>
          <p class="dl">
            <a class="btn p" href={p.pdf.href} target="_blank" rel="noopener"><b>{p.pdf.label}</b>{p.pdf.meta && <span>{p.pdf.meta}</span>}</a>
            <a class="btn" href={p.png.href} target="_blank" rel="noopener"><b>{p.png.label}</b>{p.png.meta && <span>{p.png.meta}</span>}</a>
          </p>
          <p class="links"><a href={p.all} target="_blank" rel="noopener">{p.allLabel} ↗</a></p>
          <p class="from">{p.from}</p>
        </div>
      </div>}
      <ul>
        <li>
          <h3>{o.take.feed.label}</h3><p>{o.take.feed.note}</p>
          <p class="links"><a href={o.take.feed.href}>RSS</a></p>
        </li>
        <li id="take-ai">
          <h3>{o.take.ai.label}</h3><p>{o.take.ai.note}</p>
          <p class="links"><a href={o.take.ai.llms}>{o.take.ai.llms}</a><a href={o.take.ai.json}>timeline.json</a></p>
        </li>
      </ul>
      <p class="note">{o.take.license}</p>
    </section>

    {o.making && <section class="making" aria-labelledby="makingH">
      <h2 class="sub" id="makingH">{o.makingTitle}</h2>
      <p>{o.making}</p>
      <p><a href={view.report.href} target="_blank" rel="noopener" data-report aria-haspopup="dialog">{view.report.label}</a></p>
    </section>}

    {/* 쓰는 법: 번호 판과 그림 상자 한 쌍씩 다섯 칸. 판은 벽과 같은 엔진이 화면 가까이 오면 새긴다(wall.ts).
       누르면 그 일을 한다(guide.ts). 스크립트가 없으면 href로 간다 */}
    <section class="guide" id="guide" aria-labelledby="guideH">
      <h2 class="sub" id="guideH">{o.guide.title}</h2>
      <ol>{o.guide.steps.map(s => <li><a href={s.href} data-act={s.act}>
        <span class="gd-pair" aria-hidden="true">
          <span class="gd-plate" data-kind="year" data-glyph={s.n} data-pattern="d" data-angle={+s.n % 2 ? -22 : 22} data-motif="none" data-seed={s.n}><canvas></canvas><span class="g">{s.n}</span></span>
          <span class="gd-plate" data-kind="item" data-glyph={s.glyph} data-pic={s.pic} data-pattern={s.pattern} data-angle={s.angle} data-motif="none" data-seed={s.seed}><canvas></canvas><span class="g">{s.glyph}</span></span>
        </span>
        <span class="gd-t"><b>{s.glyph}</b><span>{s.note}</span></span>
      </a></li>)}</ol>
    </section>

    <p class="end"><span>{o.end[0]}</span><span>{o.end[1]}</span></p>
    {/* 맨 아래: 만든 사람의 사이트와 X, 오른쪽에 언어 */}
    <div class="foot">
      <p class="by"><a href="https://lucasflatwhite.com/">lucasflatwhite.com</a><a href="https://x.com/lucas_flatwhite" target="_blank" rel="noopener">X @lucas_flatwhite</a></p>
      <LangSwitch view={view} />
    </div>
  </div>
</section>
